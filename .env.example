# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Convex Database
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
# RESEND_API_KEY from https://resend.com/api-keys
RESEND_API_KEY=re_...
# From address — MUST be a domain verified in Resend (see README "Email & Push")
RESEND_FROM_EMAIL=GymPro <noreply@your-verified-domain.com>

# Backend-outage monitoring (Vercel cron -> /api/cron/health)
# CRON_SECRET is set in Vercel too; Vercel sends it as a Bearer token on cron hits.
CRON_SECRET=
# Slack/Discord/Teams incoming-webhook URL receiving outage alerts.
ALERT_WEBHOOK_URL=
