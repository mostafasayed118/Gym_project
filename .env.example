# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Convex Database
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ExerciseDB catalog (RapidAPI)
# Get a key at https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
# The catalog is synced ONCE into Convex by an admin (Mission Control ->
# Exercise Database card); reads never hit the API per-request.
EXERCISEDB_API_KEY=

# Email (Gmail SMTP)
# GMAIL_APP_PASSWORD is a 16-char App Password from https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Never use your real Gmail password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Backend-outage monitoring
# Uptime monitoring runs from GitHub Actions (.github/workflows/uptime.yml):
# a probe of /api/health?deep=true every 5 minutes that alerts on failure.
# ALERT_WEBHOOK_URL is a GitHub repository secret (Slack/Discord/Teams-style
# incoming-webhook URL); GitHub's own failure notifications also fire.
ALERT_WEBHOOK_URL=
# CRON_SECRET guards /api/cron/health (bearer) for manual/periodic use — no
# longer scheduled by Vercel (Hobby allows one cron/day).
CRON_SECRET=
